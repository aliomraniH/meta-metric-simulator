# =============================================================================
# Reels AT Simulator MCP — environment variables
# Copy to .env and fill in.  Never commit .env.
# =============================================================================

# ---- MCP front door ---------------------------------------------------------
# Bearer token used by clients hitting the streamable-http endpoint.
# Rotate by setting a new value and redeploying — sessions will need to re-auth.
MCP_AUTH_TOKEN=replace-me-with-a-long-random-string

# OAuth 2.1 issuer + audience.  Per-layer scopes are derived in infra/auth.py.
# Resource Indicators (RFC 8707): each layer (l4, l5, l6, l8) has its own
# resource URI and scopes; tokens MUST NOT be passed through between layers.
MCP_OAUTH_ISSUER=https://auth.example.com
MCP_OAUTH_AUDIENCE=https://reels-sim.example.com
MCP_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# ---- Anthropic / Claude Agent SDK -------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-me

# Default models (override per-agent in orchestrator/agents.py)
ANTHROPIC_MODEL_ORCHESTRATOR=claude-opus-4-7
ANTHROPIC_MODEL_WORKER=claude-sonnet-4-6
ANTHROPIC_MODEL_SANITIZER=claude-haiku-4-5-20251001

# Fork subagents into separate processes (~90% input-token savings on fan-out).
CLAUDE_CODE_FORK_SUBAGENT=1
CLAUDE_CODE_ENABLE_TELEMETRY=1

# Prompt cache TTL — set explicitly; default silently dropped to 5m March 2026.
ANTHROPIC_PROMPT_CACHE_TTL=1h

# ---- Voyage AI (embeddings + rerank) ----------------------------------------
VOYAGE_API_KEY=pa-replace-me
VOYAGE_MODEL_DEFAULT=voyage-3-large
VOYAGE_MODEL_FINANCE=voyage-finance-2
VOYAGE_RERANK_MODEL=rerank-2.5

# ---- Redis (EventStore + cache) --------------------------------------------
# Used for resumable streamable-http (Last-Event-ID) and as a generic cache.
REDIS_URL=redis://localhost:6379/0

# ---- Database (state) -------------------------------------------------------
# Postgres preferred; Replit DB key-value used as fallback when DATABASE_URL
# is unset (see infra/db.py).  NEVER point this at a local SQLite file —
# Replit Deployments do not preserve filesystem writes across redeploys.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/reels_sim

# ---- OpenTelemetry ----------------------------------------------------------
OTEL_SERVICE_NAME=reels-sim-mcp
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4317
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# ---- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
ENV=development
